# Entity Framework 6+ dự phòng
*.Migrations.cs
# Nhưng đừng ignore file migrations quan trọng
!*.Designer.cs

# AppSettings secrets (QUAN TRỌNG)
appsettings.Development.json
appsettings.local.json
secrets.json
appsettings.json

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

