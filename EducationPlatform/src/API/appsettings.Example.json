{
  "ConnectionStrings": {
    "Default": "Host=your_host;Database=your_db;Username=your_username;Password=your_password"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  },
  "JwtSettings": {
    "Issuer": "EducationPlatform",
    "Audience": "Educators",
    "SecretKey": "YOUR_SECRET_KEY_MUST_BE_AT_LEAST_32_CHARACTERS_LONG",
    "ExpiryMinutes": 60
  },
  "Storage": {
    "RootPath": "C:/path/to/storage"
  },
  "Upload": {
    "MaxChunkBytes": 33554432,
    "MaxChunksPerUpload": 2000,
    "MaxTotalBytesPerUpload": 2147483648
  },
  "PayOS": {
    "ClientId": "YOUR_PAYOS_CLIENT_ID",
    "ApiKey": "YOUR_PAYOS_API_KEY",
    "ChecksumKey": "YOUR_PAYOS_CHECKSUM_KEY",
    "ReturnUrl": "https://localhost:7029/api/orders/return",
    "CancelUrl": "http://localhost:3000/student?payment=cancelled",
    "FrontendUrl": "http://localhost:3000"
  },
  "EmailSettings": {
    "From": "your_email@gmail.com",
    "DisplayName": "Education Platform",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "your_email@gmail.com",
    "Password": "your_gmail_app_password",
    "EnableSSL": true
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "TrustAll": false
  },
  "RateLimiting": {
    "Enabled": true
  },
  "Database": {
    "AutoMigrate": true,
    "SeedDemoData": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "File": {
      "Enabled": false
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "",
    "ServiceName": "education-platform-api"
  },
  "Admin": {
    "Email": "",
    "Password": "",
    "Phone": "0000000000",
    "Name": "Platform Administrator"
  },
  "Retention": {
    "Enabled": true,
    "RefreshSessionGraceDays": 7,
    "AuditLogDays": 365,
    "UnverifiedUserDays": 7
  }
}
