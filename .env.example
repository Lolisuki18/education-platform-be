# Copy to `.env` (git-ignored) to override the development defaults of docker-compose.yml.
# These variables are only read by docker compose; the application itself is configured through
# appsettings.json or environment variables such as ConnectionStrings__Default (see README).

POSTGRES_PASSWORD=change-me
JWT_SECRET=at-least-32-characters-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Choose-a-strong-password-1

# Only needed to actually take payments in development
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
