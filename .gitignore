# AppSettings secrets
appsettings.Development.json
appsettings.local.json
secrets.json
**/appsettings.json
!**/UnitTests/appsettings.json
!**/IntegrationTests/appsettings.json

# OS generated files
.DS_Store
.DS_Store?
._*
